# Legends Lab — variables opcionales. La app funciona SIN ninguna clave (dataset local).
# Nunca subas un .env real al repositorio. Estas claves solo se leen en rutas de servidor.

# BALLDONTLIE (https://www.balldontlie.io) — free tier: teams/players/games, 5 req/min.
# Estadísticas por temporada requieren plan de pago.
BALLDONTLIE_API_KEY=

# football-data.org — free tier: 12 competiciones, ~10 req/min, cabecera X-Auth-Token.
FOOTBALL_DATA_API_KEY=

# API-Football v3 (api-sports.io) — free: 100 req/día, cabecera x-apisports-key.
API_FOOTBALL_KEY=
